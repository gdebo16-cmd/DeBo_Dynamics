{
  // Cloudflare Workers config: serves the Vite build as a static site.
  "name": "debo-dynamics",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    // Unknown paths like /resume get index.html so React Router can handle them.
    "not_found_handling": "single-page-application"
  }
}
